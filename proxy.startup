ifconfig eth0 10.0.1.20/24 up
ip route add default via 10.0.1.1
echo "nameserver 8.8.8.8" > /etc/resolv.conf

# Instala o Squid caso não esteja presente no container e decide manter a escolha do arquivo squid.conf personalizado pelo usuario
which squid || (apt-get update && apt-get install -y squid -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold")

# Garante permissões de cache e inicia o Squid
mkdir -p /var/spool/squid /var/log/squid
chown -R proxy:proxy /var/spool/squid /var/log/squid
squid -z 2>/dev/null

# 1. Mata qualquer instância pré-existente iniciada pelo apt
pkill -9 squid || true
rm -f /run/squid.pid

# 2. Inicia o Squid em segundo plano (modo daemon)
service squid start