ifconfig eth0 10.0.2.10/24 up
ip route add default via 10.0.2.1
echo "nameserver 8.8.8.8" > /etc/resolv.conf

# Instala o NGINX caso não esteja presente no container e decide manter a escolha do arquivo default personalizado pelo usuario
which nginx || (apt-get update && apt-get install -y nginx -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold")

# Inicia o serviço NGINX
nginx