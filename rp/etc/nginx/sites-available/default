server {
    listen 80 default_server;
    server_name _;

    # Rate Limiting: Define zona de controle de requisições
    limit_req zone=one burst=5 nodelay;

    # Encaminhamento Padrão para o servidor Web da DMZ
    location / {
        proxy_pass http://10.0.2.20:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # CONTROLE L7 #1: Proteção e Restrição de Acesso à Rota /admin
    location /admin {
        allow 10.0.3.0/24;  # Permite acesso exclusivo da rede MGMT
        deny all;           # Bloqueia qualquer outra origem (WAN/LAN)
        proxy_pass http://10.0.2.20:80;
    }

    # CONTROLE L7 #2: Restrição de Métodos HTTP (Permite apenas GET e POST)
    location /public {
        proxy_pass http://10.0.2.20:80;
        limit_except GET POST {
            deny all;
        }
    }

    # CONTROLE L7 #3: Limitação do tamanho das requisições
    client_max_body_size 1m;

    # CONTROLE L7 #4: Headers de segurança
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    }